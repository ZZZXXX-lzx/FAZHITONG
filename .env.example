# 法智通法律服务平台环境变量配置
# 复制此文件为 .env 并修改对应的值

# MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fazhitong
DB_USERNAME=root
DB_PASSWORD=123456

# AI 大模型配置（OpenAI 兼容协议，不配置则 AI 功能自动降级为规则引擎）
# 支持 DeepSeek / 通义千问(兼容模式) / Moonshot Kimi / 智谱GLM / OpenAI 等
# 示例（DeepSeek）：
#   AI_API_KEY=sk-xxxxxxxx
#   AI_BASE_URL=https://api.deepseek.com/v1
#   AI_MODEL=deepseek-chat
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# 前端开发端口
PC_PORTAL_PORT=3000
ADMIN_PORT=3001
